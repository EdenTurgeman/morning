# spec.md IS tracked. It is the app's functional specification — what the app
# must do, with no UI or UX decisions in it — and a specification nobody else
# can read is not a specification. It contains nothing about the person this was
# built for; anything that does goes in the file below and stays local.
spec.private.md

node_modules/
dist/
*.local
.DS_Store
Thumbs.db
*.tsbuildinfo

# --- iOS port -----------------------------------------------------------------
# The Xcode project is a normal committed .xcodeproj. Only per-user state
# inside it is ignored.
ios/Morning.xcodeproj/project.xcworkspace/
ios/*.xcworkspace/
ios/Local.xcconfig
ios/build/
ios/DerivedData/
**/xcuserdata/
*.xcuserstate
.DS_Store
